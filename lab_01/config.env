# Default configuration for lab_01.
# Override any value via the shell or `make VAR=...` (highest priority),
# or by putting it in lab_01/.env.

# AWS region. Each teammate can use a different one. First match wins:
#   1. AWS_REGION from the shell, `make VAR=...`, or lab_01/.env
#   2. AWS_DEFAULT_REGION from the shell
#   3. the region of the AWS CLI profile in use (`aws configure get region`,
#      which honours AWS_PROFILE)
#   4. ap-southeast-2 (Sydney) as a last resort
AWS_REGION="${AWS_REGION:-${AWS_DEFAULT_REGION:-$(aws configure get region 2>/dev/null || true)}}"
AWS_REGION="${AWS_REGION:-ap-southeast-2}"

# Prefix for every resource name. Lowercase letters, digits, hyphens; max 20 chars.
PROJECT="${PROJECT:-lab01-wp}"

# Networking: the lab uses the region's default VPC (see scripts/00-network.sh).
# CIDR allowed to SSH into the web servers. Empty = your current public IP/32.
SSH_CIDR="${SSH_CIDR:-}"

# Compute
INSTANCE_TYPE="${INSTANCE_TYPE:-t3.micro}"

# Database (RDS MySQL)
DB_INSTANCE_CLASS="${DB_INSTANCE_CLASS:-db.t3.micro}"
DB_STORAGE_GB="${DB_STORAGE_GB:-20}"
DB_NAME="${DB_NAME:-wordpress}"
DB_USER="${DB_USER:-wpadmin}"

# WordPress site (passwords are generated into .state/secrets.env)
WP_TITLE="${WP_TITLE:-HCMUS Cloud Computing Lab 01}"
WP_ADMIN_USER="${WP_ADMIN_USER:-admin}"
WP_ADMIN_EMAIL="${WP_ADMIN_EMAIL:-admin@example.com}"
